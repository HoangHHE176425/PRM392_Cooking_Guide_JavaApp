<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Màu nền trắng -->
    <solid android:color="#FFFFFF" />

    <!-- Bo góc nhẹ -->
    <corners android:radius="12dp" />

    <!-- Viền mảnh -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0" />

    <!-- Padding -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
